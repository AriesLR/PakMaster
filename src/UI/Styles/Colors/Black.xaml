<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:options="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="options">

    <!-- Black 100% Opacity -->
    <Color x:Key="Alr.Colors.Black">#FF000000</Color>
    <SolidColorBrush x:Key="Alr.Brushes.Black" Color="{StaticResource Alr.Colors.Black}" options:Freeze="True" />

    <!-- Black 80% Opacity -->
    <Color x:Key="Alr.Colors.Black.O80">#CC000000</Color>
    <SolidColorBrush x:Key="Alr.Brushes.Black.O80" Color="{StaticResource Alr.Colors.Black.O80}" options:Freeze="True" />

    <!-- Black 60% Opacity -->
    <Color x:Key="Alr.Colors.Black.O60">#99000000</Color>
    <SolidColorBrush x:Key="Alr.Brushes.Black.O60" Color="{StaticResource Alr.Colors.Black.O60}" options:Freeze="True" />

    <!-- Black 40% Opacity -->
    <Color x:Key="Alr.Colors.Black.O40">#66000000</Color>
    <SolidColorBrush x:Key="Alr.Brushes.Black.O40" Color="{StaticResource Alr.Colors.Black.O40}" options:Freeze="True" />

    <!-- Black 20% Opacity -->
    <Color x:Key="Alr.Colors.Black.O20">#33000000</Color>
    <SolidColorBrush x:Key="Alr.Brushes.Black.O20" Color="{StaticResource Alr.Colors.Black.O20}" options:Freeze="True" />
</ResourceDictionary>
