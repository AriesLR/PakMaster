<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:options="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="options">

    <!-- White 100% Opacity -->
    <Color x:Key="Alr.Colors.White">#FFFFFFFF</Color>
    <SolidColorBrush x:Key="Alr.Brushes.White" Color="{StaticResource Alr.Colors.White}" options:Freeze="True" />

    <!-- White 80% Opacity -->
    <Color x:Key="Alr.Colors.White.O80">#CCFFFFFF</Color>
    <SolidColorBrush x:Key="Alr.Brushes.White.O80" Color="{StaticResource Alr.Colors.White.O80}" options:Freeze="True" />

    <!-- White 60% Opacity -->
    <Color x:Key="Alr.Colors.White.O60">#99FFFFFF</Color>
    <SolidColorBrush x:Key="Alr.Brushes.White.O60" Color="{StaticResource Alr.Colors.White.O60}" options:Freeze="True" />

    <!-- White 40% Opacity -->
    <Color x:Key="Alr.Colors.White.O40">#66FFFFFF</Color>
    <SolidColorBrush x:Key="Alr.Brushes.White.O40" Color="{StaticResource Alr.Colors.White.O40}" options:Freeze="True" />

    <!-- White 20% Opacity -->
    <Color x:Key="Alr.Colors.White.O20">#33FFFFFF</Color>
    <SolidColorBrush x:Key="Alr.Brushes.White.O20" Color="{StaticResource Alr.Colors.White.O20}" options:Freeze="True" />
</ResourceDictionary>
