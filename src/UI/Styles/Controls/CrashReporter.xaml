<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:options="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="options">

    <!-- ======== Crash Reporter Styles ======== -->
    <Color x:Key="Alr.Colors.CrashReporter.Gray.SemiTransparent">#40808080</Color>
    <Color x:Key="Alr.Colors.CrashReporter.Foreground">#FFFFFFFF</Color>
    <Color x:Key="Alr.Colors.CrashReporter.Background">#FF252525</Color>
    <Color x:Key="Alr.Colors.CrashReporter.AltBackground">#FF2F2F2F</Color>
    <SolidColorBrush x:Key="Alr.Brushes.CrashReporter.Gray.SemiTransparent" Color="{StaticResource Alr.Colors.CrashReporter.Gray.SemiTransparent}" options:Freeze="True" />
    <SolidColorBrush x:Key="Alr.Brushes.CrashReporter.Foreground" Color="{StaticResource Alr.Colors.CrashReporter.Foreground}" options:Freeze="True" />
    <SolidColorBrush x:Key="Alr.Brushes.CrashReporter.Background" Color="{StaticResource Alr.Colors.CrashReporter.Background}" options:Freeze="True" />
    <SolidColorBrush x:Key="Alr.Brushes.CrashReporter.AltBackground" Color="{StaticResource Alr.Colors.CrashReporter.AltBackground}" options:Freeze="True" />
</ResourceDictionary>
