<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:options="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="options">

    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Style.Resources>
            <SolidColorBrush x:Key="MahApps.Brushes.Button.Border"
                             Color="{StaticResource MahApps.Colors.Gray7}"
                             options:Freeze="True" />
            <SolidColorBrush x:Key="MahApps.Brushes.Button.Border.Focus"
                             Color="{StaticResource MahApps.Colors.Gray7}"
                             options:Freeze="True" />
            <SolidColorBrush x:Key="MahApps.Brushes.Button.Border.MouseOver"
                             Color="{StaticResource MahApps.Colors.Gray5}"
                             options:Freeze="True" />
        </Style.Resources>
    </Style>
</ResourceDictionary>
