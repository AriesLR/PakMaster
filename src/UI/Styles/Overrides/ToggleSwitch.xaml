<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:options="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                    mc:Ignorable="options">

    <Style TargetType="{x:Type mah:ToggleSwitch}" BasedOn="{StaticResource {x:Type mah:ToggleSwitch}}">
        <Style.Resources>
            <SolidColorBrush x:Key="MahApps.Brushes.ToggleSwitch.FillOn" Color="{DynamicResource Alr.Colors.Gray400}" />
            <SolidColorBrush x:Key="MahApps.Brushes.ToggleSwitch.FillOnPointerOver" Color="{DynamicResource Alr.Colors.Gray300}" />
            <SolidColorBrush x:Key="MahApps.Brushes.ToggleSwitch.FillOnPressed" Color="{DynamicResource MahApps.Colors.Gray1}" />
        </Style.Resources>
    </Style>
</ResourceDictionary>