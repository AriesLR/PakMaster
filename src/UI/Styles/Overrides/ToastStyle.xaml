<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:options="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:core="clr-namespace:Notification.Core;assembly=Notification.Core"
                    xmlns:notifWpf="clr-namespace:Notification.Wpf;assembly=Notification.Wpf"
                    xmlns:notifications="clr-namespace:Notification.Wpf.Controls;assembly=Notification.Wpf"
                    xmlns:views="clr-namespace:PakMaster.UI.Views">

    <DataTemplate DataType="{x:Type notifWpf:NotificationContent}">
        <views:CustomToastView />
    </DataTemplate>

    <Style TargetType="{x:Type notifications:Notification}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type notifications:Notification}">
                    <ContentPresenter Content="{TemplateBinding Content}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>