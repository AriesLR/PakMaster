<mah:MetroWindow x:Class="PakMaster.CrashReportWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 xmlns:constants="clr-namespace:PakMaster.Core.Constants"
                 xmlns:lex="http://wpflocalizeextension.codeplex.com"
                 lex:LocalizeDictionary.DesignCulture="en"
                 lex:ResxLocalizationProvider.DefaultAssembly="PakMaster"
                 lex:ResxLocalizationProvider.DefaultDictionary="PakMaster.UI.Resources.Resources"
                 xmlns:extensions="clr-namespace:PakMaster.Core.Extensions"
                 FlowDirection="{extensions:FlowDirection}"
                 Height="720"
                 Width="960"
                 FontFamily="Segoe UI"
                 GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
                 NonActiveGlowBrush="{DynamicResource MahApps.Brushes.Accent}"
                 WindowStartupLocation="CenterScreen"
                 ResizeMode="NoResize">

    <Window.Title>
        <MultiBinding Converter="{lex:StringFormatConverter}">
            <Binding Source="{lex:Loc CrashReportWindow_Title}" />
            <Binding Source="{x:Static constants:AppConfig.DisplayAppName}" />
        </MultiBinding>
    </Window.Title>

    <mah:MetroWindow.Resources>
        <SolidColorBrush x:Key="MahApps.Brushes.WindowTitle" Color="{DynamicResource MahApps.Colors.Accent}" />
        <SolidColorBrush x:Key="MahApps.Brushes.WindowTitle.NonActive" Color="{DynamicResource MahApps.Colors.Accent}" />
        <SolidColorBrush x:Key="MahApps.Brushes.Border.NonActive" Color="{DynamicResource MahApps.Colors.Accent}" />
    </mah:MetroWindow.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Vector Error Icon -->
            <iconPacks:PackIconMaterial Grid.Column="0" Width="36" Height="36" Kind="Alert" Foreground="{StaticResource Alr.Brushes.Orange600}" VerticalAlignment="Center" Margin="0,0,15,0" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="{lex:Loc CrashReportWindow_Header_SomethingWentWrong}" />
                <TextBlock FontSize="12" Text="{lex:Loc CrashReportWindow_Desc}" Margin="0,2,0,0" />
            </StackPanel>
        </Grid>

        <!-- Message and Log Path -->
        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{lex:Loc CrashReportWindow_Lbl_Exception}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Margin="0,0,8,0" />

                <TextBlock x:Name="ExceptionMessageTextBlock"
                           FlowDirection="LeftToRight"
                           Grid.Column="1"
                           Text="{lex:Loc CrashReportWindow_Lbl_ExceptionPlaceholder}"
                           FontSize="13"
                           TextWrapping="Wrap" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{lex:Loc CrashReportWindow_Lbl_LogFileLocation}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                <TextBox Grid.Column="1" x:Name="LogPathTextBox" FlowDirection="LeftToRight" BorderBrush="{StaticResource MahApps.Brushes.Gray.SemiTransparent}" Background="{StaticResource Alr.Brushes.CrashReporter.AltBackground}" FontFamily="Consolas" FontSize="12" Height="24" IsReadOnly="True" VerticalContentAlignment="Center" Text="C:\Path\To\debug.log" />
            </Grid>
        </StackPanel>

        <!-- Details -->
        <Grid Grid.Row="2" Margin="0,0,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{lex:Loc CrashReportWindow_Lbl_Details}" FontSize="11" FontWeight="Bold" Margin="0,0,0,5" />
            <TextBox Grid.Row="1" x:Name="StackTraceTextBox" Text="{lex:Loc CrashReportWindow_Lbl_DetailsPlaceholder}" BorderBrush="{StaticResource MahApps.Brushes.Gray.SemiTransparent}" Background="{StaticResource Alr.Brushes.CrashReporter.AltBackground}" FontFamily="Consolas" FontSize="12" IsReadOnly="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FlowDirection="LeftToRight" />
        </Grid>

        <!-- Buttons -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="CloseButton" Grid.Column="0" Content="{lex:Loc CrashReportWindow_Btn_Close}" Width="130" Height="32" HorizontalAlignment="Left" Click="CloseButton_Click" />
            <Button x:Name="SubmitButton" Grid.Column="1" Content="{lex:Loc CrashReportWindow_Btn_SendCrashReport}" Width="200" Height="32" HorizontalAlignment="Right" Click="SubmitButton_Click" />
        </Grid>
    </Grid>
</mah:MetroWindow>
