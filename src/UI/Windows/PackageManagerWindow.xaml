<mah:MetroWindow x:Class="PakMaster.UI.Windows.PackageManagerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:lex="http://wpflocalizeextension.codeplex.com"
                 lex:LocalizeDictionary.DesignCulture="en"
                 lex:ResxLocalizationProvider.DefaultAssembly="PakMaster"
                 lex:ResxLocalizationProvider.DefaultDictionary="PakMaster.UI.Resources.Resources"
                 Title="{lex:Loc PackageManagerWindow_PackageManager}"
                 Height="650" Width="1000"
                 MinHeight="650" MinWidth="1000"
                 WindowStartupLocation="CenterScreen"
                 Closing="MetroWindow_Closing"
                 Closed="MetroWindow_Closed"
                 FontFamily="Segoe UI"
                 GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
                 NonActiveGlowBrush="{DynamicResource MahApps.Brushes.Accent}"
                 Background="{DynamicResource Alr.Brushes.DarkBg900}"
                 WindowStyle="SingleBorderWindow"
                 ResizeMode="CanResizeWithGrip">

    <mah:MetroWindow.Resources>
        <SolidColorBrush x:Key="MahApps.Brushes.WindowTitle" Color="{DynamicResource MahApps.Colors.Accent}" />
        <SolidColorBrush x:Key="MahApps.Brushes.WindowTitle.NonActive" Color="{DynamicResource MahApps.Colors.Accent}" />
        <SolidColorBrush x:Key="MahApps.Brushes.Border.NonActive" Color="{DynamicResource MahApps.Colors.Accent}" />
    </mah:MetroWindow.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="15" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>

            <!-- Retoc -->
            <GroupBox Grid.Row="0">
                <GroupBox.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Retoc" VerticalAlignment="Center" />
                        <CheckBox x:Name="SelectAllRetoc" Grid.Column="1" Content="{lex:Loc PackageManagerWindow_SelectAll}" VerticalAlignment="Center" Margin="10,0,0,0" Checked="SelectAllRetoc_Checked" Unchecked="SelectAllRetoc_Unchecked" />
                    </Grid>
                </GroupBox.Header>
                <ListBox x:Name="RetocList" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <CheckBox IsChecked="{Binding PendingInstallState, Mode=TwoWay}"
                                          Content="{Binding DisplayName}"
                                          Tag="{Binding}"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>

            <!-- Repak -->
            <GroupBox Grid.Row="2">
                <GroupBox.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Repak" VerticalAlignment="Center" />
                        <CheckBox x:Name="SelectAllRepak" Grid.Column="1" Content="{lex:Loc PackageManagerWindow_SelectAll}" VerticalAlignment="Center" Margin="10,0,0,0" Checked="SelectAllRepak_Checked" Unchecked="SelectAllRepak_Unchecked" />
                    </Grid>
                </GroupBox.Header>
                <ListBox x:Name="RepakList" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5" Background="Transparent">
                                <CheckBox IsChecked="{Binding PendingInstallState, Mode=TwoWay}"
                                          Content="{Binding DisplayName}"
                                          Tag="{Binding}"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="CloseButton" Content="Close" Width="100" Click="CloseButton_Click" BorderBrush="{DynamicResource MahApps.Brushes.Gray7}" Background="Transparent" />
        </StackPanel>
    </Grid>
</mah:MetroWindow>