<UserControl x:Class="PakMaster.UI.Views.Taskbar.TrayIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:constants="clr-namespace:PakMaster.Core.Constants"
             xmlns:ti="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
             xmlns:local="clr-namespace:PakMaster.UI.Views.Taskbar"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             lex:LocalizeDictionary.DesignCulture="en"
             lex:ResxLocalizationProvider.DefaultAssembly="PakMaster"
             lex:ResxLocalizationProvider.DefaultDictionary="PakMaster.UI.Resources.Resources"
             xmlns:extensions="clr-namespace:PakMaster.Core.Extensions"
             FlowDirection="{extensions:FlowDirection}"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <ti:TaskbarIcon x:Name="AppTaskbarIcon"
                    IconSource="../../../appicon.ico"
                    ToolTipText="{Binding Source={x:Static constants:AppConfig.AppName}, StringFormat='\{0\}'}"
                    TrayMouseDoubleClick="TaskbarIcon_TrayMouseDoubleClick">
        <ti:TaskbarIcon.ContextMenu>
            <ContextMenu>
                <MenuItem Header="{lex:Loc TrayIcon_Header_ShowApplication}" Click="MenuShowApp_Click" FontWeight="Bold" />
                <Separator />
                <MenuItem Header="{lex:Loc TrayIcon_Header_Exit}" Click="MenuExitApp_Click" />
            </ContextMenu>
        </ti:TaskbarIcon.ContextMenu>
    </ti:TaskbarIcon>
</UserControl>
