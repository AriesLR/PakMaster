                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray.SemiTransparent}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.Style>

                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center" Margin="5,0,0,0" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>-->

                    <!-- Language Dropdown -->
                    <Grid Grid.Row="2" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,50,0">
                            <TextBlock Text="{lex:Loc AppSettings_Lbl_Language}" Foreground="{DynamicResource MahApps.Brushes.Gray6}" FontSize="14" />
                            <TextBlock Text="{lex:Loc AppSettings_Desc_Language}" Foreground="{DynamicResource MahApps.Brushes.Gray7}" FontSize="12" TextWrapping="Wrap" Padding="0,0,50,0" />
                        </StackPanel>

                        <ComboBox x:Name="LanguageDropdown"
                                  Grid.Column="1"
                                  Width="150"
                                  Height="35"
                                  mah:ControlsHelper.CornerRadius="2"
                                  Background="{DynamicResource MahApps.Brushes.Transparent}"
                                  BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                                  Foreground="{DynamicResource MahApps.Brushes.Gray6}"
                                  VerticalAlignment="Center"
                                  BorderThickness="1"
                                  VerticalContentAlignment="Center"
                                  ItemsSource="{Binding SupportedLanguages, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="LanguageDropdown_SelectionChanged"
                                  mah:TextBoxHelper.Watermark="Select Language...">

                            <ComboBox.Resources>
                                <SolidColorBrush x:Key="MahApps.Brushes.ComboBox.Border.MouseOver" Color="{DynamicResource MahApps.Colors.Gray5}" />
                                <SolidColorBrush x:Key="MahApps.Brushes.ComboBox.Border.Focus" Color="{DynamicResource MahApps.Colors.Gray7}" />
                                <SolidColorBrush x:Key="MahApps.Brushes.ComboBox.PopupBorder" Color="{DynamicResource MahApps.Colors.Gray7}" />
                                <SolidColorBrush x:Key="MahApps.Brushes.Gray1" Color="{StaticResource MahApps.Colors.Gray}" />
                                <SolidColorBrush x:Key="MahApps.Brushes.Gray5" Color="{StaticResource MahApps.Colors.Gray.SemiTransparent}" />
                            </ComboBox.Resources>
                        </ComboBox>
                    </Grid>

                    <!-- Accent Color Dropdown -->
                    <Grid Grid.Row="3" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,50,0">
                            <TextBlock Text="{lex:Loc AppSettings_Lbl_AccentColor}" Foreground="{DynamicResource MahApps.Brushes.Gray6}" FontSize="14" />
                            <TextBlock Text="{lex:Loc AppSettings_Desc_AccentColor}" Foreground="{DynamicResource MahApps.Brushes.Gray7}" FontSize="12" TextWrapping="Wrap" Padding="0,0,50,0" />
                        </StackPanel>

                        <ComboBox x:Name="AccentColorDropdown"
                                  Grid.Column="1"
                                  Width="150"
                                  Height="35"
                                  mah:ControlsHelper.CornerRadius="2"
                                  Background="{DynamicResource MahApps.Brushes.Transparent}"
                                  BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                                  Foreground="{DynamicResource MahApps.Brushes.Gray6}"
                                  VerticalAlignment="Center"
                                  BorderThickness="1"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="AccentColorDropdown_SelectionChanged"
                                  mah:TextBoxHelper.Watermark="Select Color...">

                            <ComboBox.Resources>
                                <SolidColorBrush x:Key="MahApps.Brushes.ComboBox.Border.MouseOver" Color="{DynamicResource MahApps.Colors.Gray5}" />
                                <SolidColorBrush x:Key="MahApps.Brushes.ComboBox.Border.Focus" Color="{DynamicResource MahApps.Colors.Gray7}" />
                                <SolidColorBrush x:Key="MahApps.Brushes.ComboBox.PopupBorder" Color="{DynamicResource MahApps.Colors.Gray7}" />
                                <SolidColorBrush x:Key="MahApps.Brushes.Gray1" Color="{StaticResource MahApps.Colors.Gray}" />
                                <SolidColorBrush x:Key="MahApps.Brushes.Gray5" Color="{StaticResource MahApps.Colors.Gray.SemiTransparent}" />
                            </ComboBox.Resources>

                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray.SemiTransparent}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>

                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2,0,0,0">
                                        <Ellipse Width="12"
                                                 Height="12"
                                                 Fill="{Binding ShowcaseBrush}"
                                                 Stroke="{DynamicResource MahApps.Brushes.ThemeForeground}"
                                                 StrokeThickness="0.5"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ColorScheme}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <!-- Interface Scale Slider -->
                    <Grid Grid.Row="4" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,50,0">
                            <TextBlock Text="{lex:Loc AppSettings_Lbl_InterfaceScale}" Foreground="{DynamicResource MahApps.Brushes.Gray6}" FontSize="14" />
                            <TextBlock Text="{lex:Loc AppSettings_Desc_InterfaceScale}" Foreground="{DynamicResource MahApps.Brushes.Gray7}" FontSize="12" TextWrapping="Wrap" Padding="0,0,50,0" />
                        </StackPanel>

                        <Slider x:Name="InterfaceScaleSlider"
                                x:FieldModifier="public"
                                Grid.Column="1"
                                Width="150"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"

                                Minimum="75"
                                Maximum="150"
                                Value="100"

                                TickFrequency="5"
                                IsSnapToTickEnabled="False"
                                TickPlacement="TopLeft"

                                AutoToolTipPlacement="TopLeft"

                                SmallChange="1"
                                LargeChange="5"
                                mah:SliderHelper.ChangeValueBy="LargeChange"
                                mah:SliderHelper.EnableMouseWheel="MouseHover"

                                Thumb.DragCompleted="InterfaceScaleSlider_DragCompleted"
                                ValueChanged="InterfaceScaleSlider_ValueChanged" />
                    </Grid>

                    <!-- Application Behavior Section -->
                    <Separator Grid.Row="5" Background="{StaticResource MahApps.Brushes.Gray.SemiTransparent}" Margin="0,10,0,20" />
                    <TextBlock Grid.Row="6" Text="{lex:Loc AppSettings_Section_ApplicationBehavior}" Foreground="{DynamicResource MahApps.Brushes.Accent}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15" />

                    <!-- Start With Windows Toggle -->
                    <Grid Grid.Row="7" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,50,0">
                            <TextBlock Text="{lex:Loc AppSettings_Lbl_StartWithWindows}" Foreground="{DynamicResource MahApps.Brushes.Gray6}" FontSize="14" />
                            <TextBlock Text="{lex:Loc AppSettings_Desc_StartWithWindows}" Foreground="{DynamicResource MahApps.Brushes.Gray7}" FontSize="12" TextWrapping="Wrap" Padding="0,0,150,0" />
                        </StackPanel>
                        <mah:ToggleSwitch Grid.Column="1" x:Name="StartWithWindowsToggle"
                                          OnContent="" OffContent=""
                                          Margin="0,0,-100,0"
                                          HorizontalAlignment="Right"
                                          Toggled="StartWithWindowsToggle_Toggled"
                                          Style="{StaticResource MahApps.Styles.ToggleSwitch}"
                                          VerticalAlignment="Center" />
                    </Grid>

                    <!-- Always On Top Toggle -->
                    <Grid Grid.Row="8" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,50,0">
                            <TextBlock Text="{lex:Loc AppSettings_Lbl_AlwaysOnTop}" Foreground="{DynamicResource MahApps.Brushes.Gray6}" FontSize="14" />
                            <TextBlock Text="{lex:Loc AppSettings_Desc_AlwaysOnTop}" Foreground="{DynamicResource MahApps.Brushes.Gray7}" FontSize="12" TextWrapping="Wrap" Padding="0,0,150,0" />
                        </StackPanel>
                        <mah:ToggleSwitch Grid.Column="1" x:Name="AlwaysOnTopToggle"
                                          OnContent="" OffContent=""
                                          Margin="0,0,-100,0"
                                          HorizontalAlignment="Right"
                                          Toggled="AlwaysOnTopToggle_Toggled"
                                          Style="{StaticResource MahApps.Styles.ToggleSwitch}"
                                          VerticalAlignment="Center" />
                    </Grid>

                    <!-- Minimize To Tray Toggle -->
                    <Grid Grid.Row="9" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,50,0">
                            <TextBlock Text="{lex:Loc AppSettings_Lbl_MinimizeToTray}" Foreground="{DynamicResource MahApps.Brushes.Gray6}" FontSize="14" />
                            <TextBlock Text="{lex:Loc AppSettings_Desc_MinimizeToTray}" Foreground="{DynamicResource MahApps.Brushes.Gray7}" FontSize="12" TextWrapping="Wrap" Padding="0,0,150,0" />
                        </StackPanel>
                        <mah:ToggleSwitch Grid.Column="1" x:Name="MinimizeToTrayToggle"
                                          OnContent="" OffContent=""
                                          Margin="0,0,-100,0"
                                          HorizontalAlignment="Right"
                                          Toggled="MinimizeToTrayToggle_Toggled"
                                          Style="{StaticResource MahApps.Styles.ToggleSwitch}"
                                          VerticalAlignment="Center" />
                    </Grid>

                    <!-- Updates Section -->
                    <Separator Grid.Row="10" Background="{StaticResource MahApps.Brushes.Gray.SemiTransparent}" Margin="0,10,0,20" />
                    <TextBlock Grid.Row="11" Text="{lex:Loc AppSettings_Section_Updates}" Foreground="{DynamicResource MahApps.Brushes.Accent}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15" />

                    <!-- Check for Updates on Startup -->
                    <Grid Grid.Row="12" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,50,0">
                            <TextBlock Text="{lex:Loc AppSettings_Lbl_CheckForUpdatesOnStartup}" Foreground="{DynamicResource MahApps.Brushes.Gray6}" FontSize="14" />
                            <TextBlock Text="{lex:Loc AppSettings_Desc_CheckForUpdatesOnStartup}" Foreground="{DynamicResource MahApps.Brushes.Gray7}" FontSize="12" TextWrapping="Wrap" Padding="0,0,150,0" />
                        </StackPanel>
                        <mah:ToggleSwitch Grid.Column="1" x:Name="CheckAppUpdatesToggle"
                                          OnContent="" OffContent=""
                                          Margin="0,0,-100,0"
                                          HorizontalAlignment="Right"
                                          Toggled="CheckAppUpdatesToggle_Toggled"
                                          Style="{StaticResource MahApps.Styles.ToggleSwitch}"
                                          VerticalAlignment="Center" />
                    </Grid>

                    <!-- Check for Updates Button -->
                    <Grid Grid.Row="13" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,50,0">
                            <TextBlock Text="{lex:Loc AppSettings_Lbl_CheckForUpdates}" Foreground="{DynamicResource MahApps.Brushes.Gray6}" FontSize="14" />
                            <TextBlock Text="{lex:Loc AppSettings_Desc_CheckForUpdates}" Foreground="{DynamicResource MahApps.Brushes.Gray7}" FontSize="12" TextWrapping="Wrap" Padding="0,0,200,0" />
                        </StackPanel>

                        <Button x:Name="CheckAppUpdatesButton"
                                Width="{lex:Loc Num_AppSettings_Btn_CheckForUpdates_Width}"
                                Height="35"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0 0 0 0"
                                BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                                Background="Transparent"
                                Click="CheckForUpdates_Click">

                            <Grid HorizontalAlignment="Stretch" Width="{Binding Path=ActualWidth, RelativeSource={RelativeSource AncestorType=Button}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <iconPacks:PackIconMaterial Kind="Update"
                                                            Foreground="{DynamicResource MahApps.Brushes.Gray5}"
                                                            Width="18"
                                                            Height="18"
                                                            VerticalAlignment="Center"
                                                            Margin="10,0,0,0"
                                                            Grid.Column="0" />

                                <TextBlock Text="{lex:Loc AppSettings_Btn_CheckForUpdates}"
                                           Foreground="{DynamicResource MahApps.Brushes.Gray6}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Grid.Column="1"
                                           Margin="0,0,18,0" />
                            </Grid>
                        </Button>
                    </Grid>

                    <!-- Logging Section -->
                    <Separator Grid.Row="14" Background="{StaticResource MahApps.Brushes.Gray.SemiTransparent}" Margin="0,10,0,20" />
                    <TextBlock Grid.Row="15" Text="{lex:Loc AppSettings_Section_Logging}" Foreground="{DynamicResource MahApps.Brushes.Accent}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15" />

                    <!-- Enable Debug Logging Toggle -->
                    <Grid Grid.Row="16" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,50,0">
                            <TextBlock Text="{lex:Loc AppSettings_Lbl_EnableDebugLogging}" Foreground="{DynamicResource MahApps.Brushes.Gray6}" FontSize="14" />
                            <TextBlock Text="{lex:Loc AppSettings_Desc_EnableDebugLogging}" Foreground="{DynamicResource MahApps.Brushes.Gray7}" FontSize="12" TextWrapping="Wrap" Padding="0,0,150,0" />
                        </StackPanel>
                        <mah:ToggleSwitch Grid.Column="1" x:Name="EnableDebugLoggingToggle"
                                          OnContent="" OffContent=""
                                          Margin="0,0,-100,0"
                                          HorizontalAlignment="Right"
                                          Toggled="EnableDebugLoggingToggle_Toggled"
                                          Style="{StaticResource MahApps.Styles.ToggleSwitch}"
                                          VerticalAlignment="Center" />
                    </Grid>

                    <!-- Open Logs Folder Button -->
                    <Grid Grid.Row="17" Margin="0,20,0,20">
                        <Button x:Name="OpenLogsFolderButton"
                                Width="Auto"
                                Height="35"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="20 0 20 0"
                                BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                                Background="Transparent"
                                Click="OpenLogsFolder_Click">

                            <Grid HorizontalAlignment="Stretch" Width="{Binding Path=ActualWidth, RelativeSource={RelativeSource AncestorType=Button}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <iconPacks:PackIconMaterial Kind="FolderOpen"
                                                            Foreground="{DynamicResource MahApps.Brushes.Gray5}"
                                                            Width="18"
                                                            Height="18"
                                                            VerticalAlignment="Center"
                                                            Margin="10,0,0,0"
                                                            Grid.Column="0" />

                                <TextBlock Text="{lex:Loc AppSettings_Btn_OpenLogsFolder}"
                                           Foreground="{DynamicResource MahApps.Brushes.Gray6}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Grid.Column="1"
                                           Margin="0,0,18,0" />
                            </Grid>
                        </Button>
                    </Grid>

                    <!-- Maintenance Section -->
                    <Separator Grid.Row="18" Background="{StaticResource MahApps.Brushes.Gray.SemiTransparent}" Margin="0,10,0,20" />
                    <TextBlock Grid.Row="19" Text="{lex:Loc AppSettings_Section_Maintenance}" Foreground="{DynamicResource MahApps.Brushes.Accent}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15" />

                    <!-- Reset To Factory Settings Button -->
                    <Grid Grid.Row="20" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,50,0">
                            <TextBlock Text="{lex:Loc AppSettings_Lbl_ResetToFactorySettings}" Foreground="{DynamicResource MahApps.Brushes.Gray6}" FontSize="14" />
                            <TextBlock Text="{lex:Loc AppSettings_Desc_ResetToFactorySettings}" Foreground="{DynamicResource MahApps.Brushes.Gray7}" FontSize="12" TextWrapping="Wrap" Padding="0,0,200,0" />
                        </StackPanel>

                        <Button x:Name="ResetToFactorySettingsButton"
                                Width="{lex:Loc Num_AppSettings_Btn_ResetToFactorySettings_Width}"
                                Height="35"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0 0 0 0"
                                BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                                Background="Transparent"
                                Click="ResetToFactorySettings_Click">

                            <Grid HorizontalAlignment="Stretch" Width="{Binding Path=ActualWidth, RelativeSource={RelativeSource AncestorType=Button}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <iconPacks:PackIconMaterial Kind="DeleteSweep"
                                                            Foreground="{DynamicResource MahApps.Brushes.Gray5}"
                                                            Width="18"
                                                            Height="18"
                                                            VerticalAlignment="Center"
                                                            Margin="10,0,0,0"
                                                            Grid.Column="0" />

                                <TextBlock Text="{lex:Loc AppSettings_Btn_ResetSettings}"
                                           Foreground="{DynamicResource MahApps.Brushes.Gray6}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Grid.Column="1"
                                           Margin="0,0,18,0" />
                            </Grid>
                        </Button>
                    </Grid>

                    <!-- Reset Window Position Button -->
                    <Grid Grid.Row="21" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,50,0">
                            <TextBlock Text="{lex:Loc AppSettings_Lbl_ResetWindowPosition}" Foreground="{DynamicResource MahApps.Brushes.Gray6}" FontSize="14" />
                            <TextBlock Text="{lex:Loc AppSettings_Desc_ResetWindowPosition}" Foreground="{DynamicResource MahApps.Brushes.Gray7}" FontSize="12" TextWrapping="Wrap" Padding="0,0,200,0" />
                        </StackPanel>

                        <Button x:Name="ResetWindowPositionButton"
                                Width="180"
                                Height="35"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0 0 0 0"
                                BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                                Background="Transparent"
                                Click="ResetWindowPosition_Click">

                            <Grid HorizontalAlignment="Stretch" Width="{Binding Path=ActualWidth, RelativeSource={RelativeSource AncestorType=Button}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <iconPacks:PackIconMaterial Kind="DeleteSweep"
                                                            Foreground="{DynamicResource MahApps.Brushes.Gray5}"
                                                            Width="18"
                                                            Height="18"
                                                            VerticalAlignment="Center"
                                                            Margin="10,0,0,0"
                                                            Grid.Column="0" />

                                <TextBlock Text="{lex:Loc AppSettings_Btn_ResetPosition}"
                                           Foreground="{DynamicResource MahApps.Brushes.Gray6}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Grid.Column="1"
                                           Margin="0,0,18,0" />
                            </Grid>
                        </Button>
                    </Grid>

                    <!-- Open App Config Folder Button -->
                    <Grid Grid.Row="22" Margin="0,20,0,20">
                        <Button x:Name="OpenAppConfigFolderButton"
                                Width="Auto"
                                Height="35"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="20 0 20 0"
                                BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                                Background="Transparent"
                                Click="OpenAppConfigFolder_Click">

                            <Grid HorizontalAlignment="Stretch" Width="{Binding Path=ActualWidth, RelativeSource={RelativeSource AncestorType=Button}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <iconPacks:PackIconMaterial Kind="FolderOpen"
                                                            Foreground="{DynamicResource MahApps.Brushes.Gray5}"
                                                            Width="18"
                                                            Height="18"
                                                            VerticalAlignment="Center"
                                                            Margin="10,0,0,0"
                                                            Grid.Column="0" />

                                <TextBlock Text="{lex:Loc AppSettings_Btn_OpenAppConfigFolder}"
                                           Foreground="{DynamicResource MahApps.Brushes.Gray6}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Grid.Column="1"
                                           Margin="0,0,18,0" />
                            </Grid>
                        </Button>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <!-- App Settings Flyout Footer -->
            <Border Grid.Row="1" Background="{StaticResource Alr.Brushes.Flyout.Footer.Background}" BorderBrush="{StaticResource MahApps.Brushes.Gray.SemiTransparent}" BorderThickness="0 1 0 0" Padding="15">
                <TextBlock Grid.Row="1"
                           Foreground="{DynamicResource MahApps.Brushes.Gray2}"
                           FontSize="12"
                           TextAlignment="Center"
                           Margin="0,0,0,0"
                           Text="{lex:Loc AppSettings_Footer_YourChangesAreSavedAutomatically}" />
            </Border>
        </Grid>
    </mah:Flyout>
    <!-- ============ App Settings Flyout END ============ -->

    <!-- ============ About Flyout START ============ -->
    <mah:Flyout x:Name="AboutFlyout"
            Header="{lex:Loc About_Title}"
            Position="Left"
            Width="{lex:Loc Num_About_Flyout_Width}"
            Foreground="{DynamicResource MahApps.Brushes.Flyout.Foreground}"
            Background="{DynamicResource Alr.Brushes.Flyout.Background}"
            BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
            BorderThickness="0 0 1 0"
            IsOpen="{Binding IsAboutFlyoutOpen}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <Grid Margin="25,10,25,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Separator Grid.Row="0" Background="{StaticResource MahApps.Brushes.Gray.SemiTransparent}" Margin="0,15,0,15" />

                    <!-- ================ Support START ================ -->
                    <StackPanel Grid.Row="1" Margin="0,5,0,0">
                        <StackPanel.Visibility>
                            <MultiBinding Converter="{StaticResource AllStringsNullOrEmptyToVisibilityConverter}">
                                <Binding Source="{x:Static constants:AppUrls.BuyMeACoffeeUrl}" />
                                <Binding Source="{x:Static constants:AppUrls.PatreonUrl}" />
                            </MultiBinding>
                        </StackPanel.Visibility>

                        <TextBlock Text="{lex:Loc About_Section_SupportTheDeveloper}" HorizontalAlignment="Center" Foreground="{DynamicResource MahApps.Brushes.Accent}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,20" />

                        <TextBlock Foreground="{DynamicResource MahApps.Brushes.Gray6}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,40" Padding="20,0,20,0"
                               Text="{lex:Loc About_Section_SupportTheDeveloper_Desc}" />

                        <StackPanel Orientation="Vertical">
                            <Button x:Name="BuyMeACoffeeButton" Visibility="{Binding Source={x:Static constants:AppUrls.BuyMeACoffeeUrl}, Converter={StaticResource StringToVisibilityConverter}}" Width="180" Height="35" Margin="0,0,0,12" HorizontalAlignment="Center" BorderBrush="{DynamicResource MahApps.Brushes.Gray7}" Background="Transparent" Click="OpenBuyMeACoffee_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <iconPacks:PackIconSimpleIcons Kind="BuyMeACoffee" Foreground="{DynamicResource MahApps.Brushes.Gray5}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Buy Me a Coffee" Foreground="{DynamicResource MahApps.Brushes.Gray6}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="PatreonButton" Visibility="{Binding Source={x:Static constants:AppUrls.PatreonUrl}, Converter={StaticResource StringToVisibilityConverter}}" Width="180" Height="35" Margin="0,0,0,5" HorizontalAlignment="Center" BorderBrush="{DynamicResource MahApps.Brushes.Gray7}" Background="Transparent" Click="OpenPatreon_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <iconPacks:PackIconSimpleIcons Kind="Patreon" Foreground="{DynamicResource MahApps.Brushes.Gray5}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Patreon" Foreground="{DynamicResource MahApps.Brushes.Gray6}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    <!-- ================ Support END ================ -->

                    <Separator Grid.Row="2" Background="{StaticResource MahApps.Brushes.Gray.SemiTransparent}" Margin="0,15,0,15" />

                    <!-- ================ Application Information START ================ -->
                    <StackPanel Grid.Row="3" Margin="0,5,0,10">
                        <TextBlock Text="{lex:Loc About_Section_ApplicationInformation}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MahApps.Brushes.Accent}" Margin="0,0,0,20" TextAlignment="Center" />

                        <UniformGrid Columns="2" Margin="0,0,0,15">
                            <StackPanel Margin="5,0" HorizontalAlignment="Center">
                                <TextBlock Text="{lex:Loc About_Lbl_Name}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MahApps.Brushes.Gray4}" Margin="0,0,0,2" TextAlignment="Center" />
                                <TextBlock Text="{x:Static constants:AppConfig.DisplayAppName}" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" />
                            </StackPanel>
                            <StackPanel Margin="5,0" HorizontalAlignment="Center">
                                <TextBlock Text="{lex:Loc About_Lbl_Version}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MahApps.Brushes.Gray4}" Margin="0,0,0,2" TextAlignment="Center" />
                                <TextBlock Text="{x:Static constants:AppConfig.DisplayAppVersion}" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" />
                            </StackPanel>
                        </UniformGrid>

                        <UniformGrid Columns="2" Margin="0,0,0,15">
                            <StackPanel Margin="5,0" HorizontalAlignment="Center">
                                <TextBlock Text="{lex:Loc About_Lbl_Developer}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MahApps.Brushes.Gray4}" Margin="0,0,0,2" TextAlignment="Center" />
                                <TextBlock Text="{x:Static constants:AppConfig.AppAuthor}" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" />
                            </StackPanel>
                            <StackPanel Margin="5,0" HorizontalAlignment="Center">
                                <TextBlock Text="{lex:Loc About_Lbl_License}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MahApps.Brushes.Gray4}" Margin="0,0,0,2" TextAlignment="Center" />
                                <TextBlock FontSize="13" FontWeight="SemiBold" TextAlignment="Center">
                                    <Hyperlink RequestNavigate="Hyperlink_RequestNavigate"
                                               NavigateUri="{x:Static constants:AppUrls.AppLicenseUri}">

                                        <Hyperlink.Style>
                                            <Style TargetType="Hyperlink">
                                                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Flyout.Foreground}" />
                                                <Style.Triggers>
                                                    <Trigger Property="NavigateUri" Value="{x:Null}">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Flyout.Foreground}" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Hyperlink.Style>

                                        <Run>
                                            <Run.Text>
                                                <Binding Source="{x:Static constants:AppConfig.AppLicense}" Mode="OneWay" StringFormat="{}{0}" />
                                            </Run.Text>
                                        </Run>
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </UniformGrid>

                        <UniformGrid Columns="2" Margin="0,0,0,5">
                            <StackPanel Margin="5,0" HorizontalAlignment="Center">
                                <TextBlock Text="{lex:Loc About_Lbl_TargetFramework}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MahApps.Brushes.Gray4}" Margin="0,0,0,2" TextAlignment="Center" />
                                <TextBlock Text="{x:Static constants:AppConfig.TargetFramework}" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" />
                            </StackPanel>
                            <StackPanel Margin="5,0" HorizontalAlignment="Center">
                                <TextBlock Text="{lex:Loc About_Lbl_OsArchitecture}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MahApps.Brushes.Gray4}" Margin="0,0,0,2" TextAlignment="Center" />
                                <TextBlock Text="{x:Static constants:AppConfig.OsArchitecture}" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                    <!-- ================ Application Information END ================ -->
                </Grid>
            </ScrollViewer>
        </Grid>
    </mah:Flyout>
    <!-- ============ About Flyout END ============ -->
</mah:FlyoutsControl>
