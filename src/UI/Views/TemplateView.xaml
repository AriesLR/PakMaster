<UserControl x:Class="PakMaster.UI.Views.TemplateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:constants="clr-namespace:PakMaster.Core.Constants"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:PakMaster.UI.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{x:Static constants:AppConfig.DisplayAppTemplateName}" FontSize="100" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,20" />

            <TextBlock Grid.Row="1" Width="600" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,20">
                <Run Text="Welcome to" />
                <Run Text="{x:Static constants:AppConfig.DisplayAppTemplateName}" /><Run Text="," />
                <Run Text="a WPF application template designed to speed up the early stages of development. Built on top of MahApps.Metro, it includes a handful of common features so you don't have to waste time building them from scratch, including blocking popup dialogs, non-blocking toast notifications, app update checking, theme switching, and much more!" />
            </TextBlock>

            <ScrollViewer Grid.Row="2" Margin="1,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Expander Header="Project Reference &amp; Maintenance" IsExpanded="False" Style="{StaticResource MahApps.Styles.Expander}" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Important project files and configuration settings to be aware of:"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,15"
                                       Foreground="{DynamicResource MahApps.Brushes.Gray1}" />

                            <!-- 1. Application Configuration -->
                            <TextBlock Text="1. Global Application Settings" FontWeight="Bold" Margin="0,5,0,2" />
                            <TextBlock Text="File Location: ./Core/Constants/AppConfig.cs" Foreground="{DynamicResource MahApps.Brushes.Gray3}" FontSize="11" Margin="10,0,0,2" />
                            <TextBlock Margin="15,10" TextWrapping="Wrap" FontSize="12">
                                <Run Text="Contains core strings like the" />
                                <Run Text="_appLicense" FontWeight="SemiBold" Foreground="{DynamicResource MahApps.Brushes.Accent}" />
                                <Run Text="string." />
                            </TextBlock>
                            <TextBlock Text="If you decide to change your license later, update this file." Margin="15,10" TextWrapping="Wrap" FontSize="12" />

                            <Separator Margin="0,5" Background="{DynamicResource MahApps.Brushes.Gray8}" />

                            <!-- 2. Backend URLs -->
                            <TextBlock Text="2. Navigation &amp; Support URLs" FontWeight="Bold" Margin="0,5,0,2" />
                            <TextBlock Text="File Location: ./Core/Constants/AppUrls.cs" Foreground="{DynamicResource MahApps.Brushes.Gray3}" FontSize="11" Margin="10,0,0,2" />
                            <TextBlock Margin="15,10" TextWrapping="Wrap" FontSize="12">
                                <Run Text="Stores external destination links, including support/tip platforms" />
                                <Run Text="(" /><Run Text="BuyMeACoffeeUrl" FontWeight="SemiBold" Foreground="{DynamicResource MahApps.Brushes.Accent}" />
                                <Run Text="and" />
                                <Run Text="PatreonUrl" FontWeight="SemiBold" Foreground="{DynamicResource MahApps.Brushes.Accent}" /><Run Text=")." />
                                <Run Text="Leaving these empty automatically hides the support panel in the About view." />
                            </TextBlock>
                            <TextBlock Margin="15,10" TextWrapping="Wrap" FontSize="12">
                                <Run Text="This is also where the" />
                                <Run Text="UpdateUrl" FontWeight="SemiBold" Foreground="{DynamicResource MahApps.Brushes.Accent}" />
                                <Run Text="is defined. When you are ready to publish, point this to your" />
                                <Run Text="update.json" FontWeight="SemiBold" FontStyle="Italic" />
                                <Run Text="stored online somewhere. The easiest solution is in a GitHub repo." />
                            </TextBlock>

                            <Separator Margin="0,5" Background="{DynamicResource MahApps.Brushes.Gray8}" />

                            <!-- 3. Application Update Info -->
                            <TextBlock Text="3. Remote Update Architecture" FontWeight="Bold" Margin="0,5,0,2" />
                            <TextBlock Text="File Location: ../docs/version/update.json" Foreground="{DynamicResource MahApps.Brushes.Gray3}" FontSize="11" Margin="10,0,0,2" />
                            <TextBlock Margin="15,10" TextWrapping="Wrap" FontSize="12">
                                <Run Text="The integrated update service checks a remote tracking file named" />
                                <Run Text="update.json" FontWeight="SemiBold" FontStyle="Italic" />
                                <Run Text="hosted at your project's update URL." />
                            </TextBlock>
                            <TextBlock Margin="15,10" TextWrapping="Wrap" FontSize="12">
                                <Run Text="{x:Static constants:AppConfig.DisplayAppTemplateName}" />
                                <Run Text="will automatically create the" />
                                <Run Text="update.json" FontWeight="SemiBold" FontStyle="Italic" />
                                <Run Text="for you. It will also rename your project folder to &quot;src&quot; to fit my preferred file structure for an app's GitHub repo." />
                            </TextBlock>
                            <TextBlock Text="You can find the JSON within the &quot;docs&quot; folder next to your &quot;src&quot; folder." Margin="15,10" TextWrapping="Wrap" FontSize="12" />

                            <Separator Margin="0,5" Background="{DynamicResource MahApps.Brushes.Gray8}" />

                            <!-- 4. Assembly Metadata -->
                            <TextBlock Text="4. Assembly Metadata" FontWeight="Bold" Margin="0,5,0,2" />
                            <TextBlock Foreground="{DynamicResource MahApps.Brushes.Gray3}" FontSize="11" Margin="10,0,0,2">
                                <TextBlock.Text>
                                    <Binding Source="{x:Static constants:AppConfig.AppName}" StringFormat="File Location: ./{0}.csproj" />
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Margin="15,10" TextWrapping="Wrap" FontSize="12">
                                <Run Text="Holds the assembly metadata fields including" />
                                <Run Text="Title" FontWeight="SemiBold" Foreground="{DynamicResource MahApps.Brushes.Accent}" /><Run Text="," />
                                <Run Text="Product" FontWeight="SemiBold" Foreground="{DynamicResource MahApps.Brushes.Accent}" /><Run Text=", and" />
                                <Run Text="AssemblyName" FontWeight="SemiBold" Foreground="{DynamicResource MahApps.Brushes.Accent}" /><Run Text="." />
                            </TextBlock>
                            <TextBlock Margin="15,10" TextWrapping="Wrap" FontSize="12">
                                <Run Text="Title" FontWeight="SemiBold" FontStyle="Italic" />
                                <Run Text="and" />
                                <Run Text="Product" FontWeight="SemiBold" FontStyle="Italic" />
                                <Run Text="names can support spaces, but" />
                                <Run Text="AssemblyName" FontWeight="SemiBold" FontStyle="Italic" />
                                <Run Text="should remain hyphenated or unspaced." />
                            </TextBlock>

                            <Separator Margin="0,5" Background="{DynamicResource MahApps.Brushes.Gray8}" />

                            <!-- SemVer & Versioning Notice -->
                            <Border Background="{DynamicResource MahApps.Brushes.Gray10}" CornerRadius="4" Margin="15,20" Padding="10">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,10" TextAlignment="Center">
                                        <Run Text="Always increment the" />
                                        <Run Text="MasterVersion" FontWeight="SemiBold" Foreground="{DynamicResource MahApps.Brushes.Accent}" />
                                        <Run Text="attribute in your .csproj file prior to pushing any new public release." />
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,10" TextAlignment="Center">
                                        <Run Text="When incrementing versions, make sure to also increment the version number in your" />
                                        <Run Text="update.json" FontWeight="SemiBold" FontStyle="Italic" />
                                        <Run Text="before pushing the release. Otherwise you'll end up with mismatched versions and the app will give you a warning when checking for updates." />
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,10" TextAlignment="Center">
                                        <Run Text="It is highly encouraged to adhere strictly to" />
                                        <Hyperlink NavigateUri="https://semver.org/" RequestNavigate="Hyperlink_RequestNavigate">
                                            <Run Text="Semantic Versioning (SemVer)" FontWeight="SemiBold" />
                                        </Hyperlink>
                                        <Run Text="rules." />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Features" IsExpanded="False" Style="{StaticResource MahApps.Styles.Expander}" Padding="10">
                        <StackPanel>

                            <TextBlock Text="Theme Switching" FontWeight="Bold" Margin="0,5,0,2" />
                            <TextBlock Text="Related File(s): ./Core/Styling/ThemeManager.cs | ./Views/Flyouts/MainWindowFlyoutsView.xaml.cs" Foreground="{DynamicResource MahApps.Brushes.Gray3}" FontSize="11" Margin="10,0,0,2" />
                            <TextBlock Margin="10" TextWrapping="Wrap">
                                <Run Text="Handles changing the application's accent colors." />
                            </TextBlock>

                            <Separator Margin="0,5" Background="{DynamicResource MahApps.Brushes.Gray8}" />

                            <TextBlock Text="UI Scaling" FontWeight="Bold" Margin="0,5,0,2" />
                            <TextBlock Text="Related File(s): ./UI/Layout/InterfaceScaler.cs | ./Views/Flyouts/MainWindowFlyoutsView.xaml.cs" Foreground="{DynamicResource MahApps.Brushes.Gray3}" FontSize="11" Margin="10,0,0,2" />
                            <TextBlock Margin="10" TextWrapping="Wrap">
                                <Run Text="Applies a layout transform to the root window, allowing the user to scale the entire interface up or down." />
                            </TextBlock>

                            <Separator Margin="0,5" Background="{DynamicResource MahApps.Brushes.Gray8}" />

                            <TextBlock Text="Start with Windows" FontWeight="Bold" Margin="0,5,0,2" />
                            <TextBlock Text="Related File(s): ./Views/Flyouts/MainWindowFlyoutsView.xaml.cs" Foreground="{DynamicResource MahApps.Brushes.Gray3}" FontSize="11" Margin="10,0,0,2" />
                            <TextBlock Margin="10" TextWrapping="Wrap">
                                <Run Text="Toggles a startup registry key for the Current User to automatically launch the application when Windows boots." />
                            </TextBlock>

                            <Separator Margin="0,5" Background="{DynamicResource MahApps.Brushes.Gray8}" />

                            <TextBlock Text="Always on Top" FontWeight="Bold" Margin="0,5,0,2" />
                            <TextBlock Text="Related File(s): ./Views/Flyouts/MainWindowFlyoutsView.xaml.cs" Foreground="{DynamicResource MahApps.Brushes.Gray3}" FontSize="11" Margin="10,0,0,2" />
                            <TextBlock Margin="10" TextWrapping="Wrap">
                                <Run Text="Toggles the window's Topmost property, allowing users to pin the application window above all other active programs." />
                            </TextBlock>

                            <Separator Margin="0,5" Background="{DynamicResource MahApps.Brushes.Gray8}" />

                            <TextBlock Text="Minimize to Tray" FontWeight="Bold" Margin="0,5,0,2" />
                            <TextBlock Text="Related File(s): ./Views/Flyouts/MainWindowFlyoutsView.xaml.cs" Foreground="{DynamicResource MahApps.Brushes.Gray3}" FontSize="11" Margin="10,0,0,2" />
                            <TextBlock Margin="10" TextWrapping="Wrap">
                                <Run Text="Intercepts window minimization to hide the main taskbar button and reroute the application visibility to a system tray notify icon." />
                            </TextBlock>

                            <Separator Margin="0,5" Background="{DynamicResource MahApps.Brushes.Gray8}" />

                            <TextBlock Text="Check for Updates on Startup" FontWeight="Bold" Margin="0,5,0,2" />
                            <TextBlock Text="Related File(s): ./Services/UpdateService.cs" Foreground="{DynamicResource MahApps.Brushes.Gray3}" FontSize="11" Margin="10,0,0,2" />
                            <TextBlock Margin="10" TextWrapping="Wrap">
                                <Run Text="An asynchronous boot check that compares a remote update.json manifest against the local assembly version and prompts the user to update if one is available." />
                            </TextBlock>

                            <Separator Margin="0,5" Background="{DynamicResource MahApps.Brushes.Gray8}" />

                            <TextBlock Text="Manual Update Checker" FontWeight="Bold" Margin="0,5,0,2" />
                            <TextBlock Text="Related File(s): ./Services/UpdateService.cs | ./Views/Flyouts/MainWindowFlyoutsView.xaml.cs" Foreground="{DynamicResource MahApps.Brushes.Gray3}" FontSize="11" Margin="10,0,0,2" />
                            <TextBlock Margin="10" TextWrapping="Wrap">
                                <Run Text="A manual check that compares a remote update.json manifest against the local assembly version and prompts the user to update if one is available." />
                            </TextBlock>

                            <Separator Margin="0,5" Background="{DynamicResource MahApps.Brushes.Gray8}" />

                            <TextBlock Text="Debug Logging" FontWeight="Bold" Margin="0,5,0,2" />
                            <TextBlock Text="Related File(s): ./Services/LoggingService.cs" Foreground="{DynamicResource MahApps.Brushes.Gray3}" FontSize="11" Margin="10,0,0,2" />
                            <TextBlock Margin="10" TextWrapping="Wrap">
                                <Run Text="A simple toggle to turn application logging on or off. When enabled, it writes events and errors to local text files for easier troubleshooting." />
                            </TextBlock>

                            <Separator Margin="0,5" Background="{DynamicResource MahApps.Brushes.Gray8}" />

                            <TextBlock Text="Reset to Factory Settings" FontWeight="Bold" Margin="0,5,0,2" />
                            <TextBlock Text="Related File(s): ./Core/Settings/AppSettingsManager.cs | ./Views/Flyouts/MainWindowFlyoutsView.xaml.cs" Foreground="{DynamicResource MahApps.Brushes.Gray3}" FontSize="11" Margin="10,0,0,2" />
                            <TextBlock Margin="10" TextWrapping="Wrap">
                                <Run Text="Wipes the local JSON configuration file and instantly reloads the application's hardcoded default state into memory." />
                            </TextBlock>

                            <Separator Margin="0,5" Background="{DynamicResource MahApps.Brushes.Gray8}" />

                            <TextBlock Text="Toast Notification System" FontWeight="Bold" Margin="0,5,0,2" />
                            <TextBlock Text="Related File(s): ./UI/Notifications/ToastManager.cs | ./Common/Constants/ToastConfig.cs" Foreground="{DynamicResource MahApps.Brushes.Gray3}" FontSize="11" Margin="10,0,0,2" />
                            <TextBlock Margin="10" TextWrapping="Wrap">
                                <Run Text="A notification overlay that displays popups for Info, Success, Warning, and Error messages." />
                            </TextBlock>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Debug/Testing" IsExpanded="False" Style="{StaticResource MahApps.Styles.Expander}" Padding="10">
                        <StackPanel>
                            <Grid Margin="0,15,0,15">
                                <Grid.Resources>
                                    <SolidColorBrush x:Key="MahApps.Brushes.Button.Border" Color="{StaticResource MahApps.Colors.Gray7}" />
                                    <SolidColorBrush x:Key="MahApps.Brushes.Button.Border.Focus" Color="{StaticResource MahApps.Colors.Gray7}" />
                                    <SolidColorBrush x:Key="MahApps.Brushes.Button.Border.MouseOver" Color="{StaticResource MahApps.Colors.Gray5}" />

                                    <Style x:Key="SubTestButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Height" Value="32" />
                                        <Setter Property="Margin" Value="4,0,4,0" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray6}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray7}" />
                                    </Style>
                                </Grid.Resources>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button x:Name="ToastServiceFullTestButton"
                                        Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4"
                                        Width="250" Height="35"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,15"
                                        BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                                        Background="Transparent"
                                        Click="ToastServiceFullTest_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <iconPacks:PackIconMaterial Kind="TestTube"
                                                                    Foreground="{DynamicResource MahApps.Brushes.Gray5}"
                                                                    Width="16" Height="16"
                                                                    VerticalAlignment="Center"
                                                                    Margin="0,0,8,0" />
                                        <TextBlock Text="Test All Toasts"
                                                   Foreground="{DynamicResource MahApps.Brushes.Gray6}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button x:Name="ToastInfoTestButton" Grid.Row="1" Grid.Column="0" Style="{StaticResource SubTestButtonStyle}" Click="ToastServiceInfoTest_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="InformationOutline" Foreground="{x:Static constants:ToastConfig.InformationBackgroundBrush}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="Test Info Toast" VerticalAlignment="Center" FontSize="11" />
                                    </StackPanel>
                                </Button>

                                <Button x:Name="ToastSuccessTestButton" Grid.Row="1" Grid.Column="1" Style="{StaticResource SubTestButtonStyle}" Click="ToastServiceSuccessTest_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="CheckCircleOutline" Foreground="{x:Static constants:ToastConfig.SuccessBackgroundBrush}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="Test Success Toast" VerticalAlignment="Center" FontSize="11" />
                                    </StackPanel>
                                </Button>

                                <Button x:Name="ToastWarningTestButton" Grid.Row="1" Grid.Column="2" Style="{StaticResource SubTestButtonStyle}" Click="ToastServiceWarningTest_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="AlertOutline" Foreground="{x:Static constants:ToastConfig.WarningBackgroundBrush}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="Test Warning Toast" VerticalAlignment="Center" FontSize="11" />
                                    </StackPanel>
                                </Button>

                                <Button x:Name="ToastErrorTestButton" Grid.Row="1" Grid.Column="3" Style="{StaticResource SubTestButtonStyle}" Click="ToastServiceErrorTest_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="AlertOctagonOutline" Foreground="{x:Static constants:ToastConfig.ErrorBackgroundBrush}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="Test Error Toast" VerticalAlignment="Center" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Separator Margin="0,30" Background="{DynamicResource MahApps.Brushes.Gray8}" />

                            <Grid Margin="0,15,0,15">
                                <Grid.Resources>
                                    <SolidColorBrush x:Key="MahApps.Brushes.Button.Border" Color="{StaticResource MahApps.Colors.Gray7}" />
                                    <SolidColorBrush x:Key="MahApps.Brushes.Button.Border.Focus" Color="{StaticResource MahApps.Colors.Gray7}" />
                                    <SolidColorBrush x:Key="MahApps.Brushes.Button.Border.MouseOver" Color="{StaticResource MahApps.Colors.Gray5}" />

                                    <Style x:Key="SubTestButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Height" Value="32" />
                                        <Setter Property="Margin" Value="4,0,4,0" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray6}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray7}" />
                                    </Style>
                                </Grid.Resources>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button x:Name="TestUIExceptionButton" Grid.Column="0" Style="{StaticResource SubTestButtonStyle}" Click="TestUIException_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="AlertOctagonOutline" Foreground="{x:Static constants:ToastConfig.ErrorBackgroundBrush}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="Test UI Exception" VerticalAlignment="Center" FontSize="11" />
                                    </StackPanel>
                                </Button>

                                <Button x:Name="TestUnobservedTaskExceptionButton" Grid.Column="1" Style="{StaticResource SubTestButtonStyle}" Click="TestUnobservedTaskException_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="AlertOctagonOutline" Foreground="{x:Static constants:ToastConfig.ErrorBackgroundBrush}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="Test Unobserved Task Exception" VerticalAlignment="Center" FontSize="11" />
                                    </StackPanel>
                                </Button>

                                <Button x:Name="TestFatalAppDomainExceptionButton" Grid.Column="2" Style="{StaticResource SubTestButtonStyle}" Click="TestFatalAppDomainException_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="AlertOctagonOutline" Foreground="{x:Static constants:ToastConfig.ErrorBackgroundBrush}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="Test Fatal App Domain Exception" VerticalAlignment="Center" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Separator Margin="0,30" Background="{DynamicResource MahApps.Brushes.Gray8}" />

                            <Grid Margin="0,15,0,15">
                                <Grid.Resources>
                                    <SolidColorBrush x:Key="MahApps.Brushes.Button.Border" Color="{StaticResource MahApps.Colors.Gray7}" />
                                    <SolidColorBrush x:Key="MahApps.Brushes.Button.Border.Focus" Color="{StaticResource MahApps.Colors.Gray7}" />
                                    <SolidColorBrush x:Key="MahApps.Brushes.Button.Border.MouseOver" Color="{StaticResource MahApps.Colors.Gray5}" />

                                    <Style x:Key="SubTestButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Height" Value="32" />
                                        <Setter Property="Margin" Value="4,0,4,0" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray6}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray7}" />
                                    </Style>
                                </Grid.Resources>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button x:Name="TestShowInfoButton" Grid.Column="0" Style="{StaticResource SubTestButtonStyle}" Click="TestShowInfo_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="InformationOutline" Foreground="{x:Static constants:ToastConfig.InformationBackgroundBrush}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="Test Info Message" VerticalAlignment="Center" FontSize="11" />
                                    </StackPanel>
                                </Button>

                                <Button x:Name="TestShowWarningButton" Grid.Column="1" Style="{StaticResource SubTestButtonStyle}" Click="TestShowWarning_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="AlertOutline" Foreground="{x:Static constants:ToastConfig.WarningBackgroundBrush}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="Test Warning Message" VerticalAlignment="Center" FontSize="11" />
                                    </StackPanel>
                                </Button>

                                <Button x:Name="TestShowErrorButton" Grid.Column="2" Style="{StaticResource SubTestButtonStyle}" Click="TestShowError_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="AlertOctagonOutline" Foreground="{x:Static constants:ToastConfig.ErrorBackgroundBrush}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="Test Error Message" VerticalAlignment="Center" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Separator Margin="0,30" Background="{DynamicResource MahApps.Brushes.Gray8}" />

                            <Grid Margin="0,15,0,15">
                                <Grid.Resources>
                                    <SolidColorBrush x:Key="MahApps.Brushes.Button.Border" Color="{StaticResource MahApps.Colors.Gray7}" />
                                    <SolidColorBrush x:Key="MahApps.Brushes.Button.Border.Focus" Color="{StaticResource MahApps.Colors.Gray7}" />
                                    <SolidColorBrush x:Key="MahApps.Brushes.Button.Border.MouseOver" Color="{StaticResource MahApps.Colors.Gray5}" />

                                    <Style x:Key="SubTestButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Height" Value="32" />
                                        <Setter Property="Margin" Value="4,0,4,0" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray6}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray7}" />
                                    </Style>
                                </Grid.Resources>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button x:Name="TestMessageBoxButton" Grid.Column="1" Style="{StaticResource SubTestButtonStyle}" Click="TestMessageBox_Click">
                                    <StackPanel Orientation="Horizontal">
