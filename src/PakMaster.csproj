<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
		<!-- ================ Build Info ================ -->
        <OutputType>WinExe</OutputType>
        <TargetFramework>net8.0-windows</TargetFramework>
        <RootNamespace>PakMaster</RootNamespace>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>

		<!-- ================ Single file publish settings ================ -->
        <PublishSingleFile>true</PublishSingleFile>
        <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
        <SelfContained>false</SelfContained>
        <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>

        <!-- ================ Versioning ================ -->
		<MasterVersion>0.2.0.0</MasterVersion>

		<AssemblyVersion>$(MasterVersion)</AssemblyVersion>
		<FileVersion>$(MasterVersion)</FileVersion>
		<InformationalVersion>$(MasterVersion.Remove($(MasterVersion.LastIndexOf('.'))))</InformationalVersion>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

        <!-- ================ File Info ================ -->
		<!-- Can/Should Contain Spaces -->
		<Title>PakMaster</Title>
        <Product>PakMaster</Product>
		
		<!-- No Spaces -->
		<AssemblyName>PakMaster</AssemblyName>
		
        <Description>A GUI Wrapper for Repak, ZenTools, and UnrealPak.</Description>
		
        <Company>AriesLR</Company>
        <Authors>AriesLR</Authors>
		
        <Copyright>Copyright 2026 AriesLR</Copyright>

		<!-- ================ Other ================ -->
		<ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
		
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>

		<ApplicationIcon>appicon.ico</ApplicationIcon>
		
        <ApplicationManifest>app.manifest</ApplicationManifest>

		<!-- ================ Error/Warning/Message Suppression ================ -->
		<NoWarn>$(NoWarn);SYSLIB1054</NoWarn>
    </PropertyGroup>

    <ItemGroup>
      <None Remove="appicon.ico" />
      <None Remove="Assets\Img\Splash_Bg.png" />
    </ItemGroup>

	<ItemGroup>
      <Resource Include="appicon.ico">
        <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      </Resource>
      <Resource Include="Assets\Img\Splash_Bg.png" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" NoWarn="NU1701" />
        <PackageReference Include="MahApps.Metro" Version="2.4.11" />
        <PackageReference Include="MahApps.Metro.IconPacks.Core" Version="6.2.1" />
        <PackageReference Include="MahApps.Metro.IconPacks.Material" Version="6.2.1" />
        <PackageReference Include="MahApps.Metro.IconPacks.SimpleIcons" Version="6.2.1" />
        <PackageReference Include="Notification.Wpf" Version="11.0.0" />
        <PackageReference Include="Serilog" Version="4.3.1" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="WPFLocalizeExtension" Version="3.10.0" />
    </ItemGroup>

    <ItemGroup>
        <Compile Update="UI\Resources\Resources.Designer.cs">
	        <DesignTime>True</DesignTime>
	        <AutoGen>True</AutoGen>
	        <DependentUpon>Resources.resx</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="UI\Resources\Resources.resx">
	        <Generator>PublicResXFileCodeGenerator</Generator>
	        <LastGenOutput>Resources.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>

</Project>
